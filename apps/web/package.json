{
  "name": "@hiveswarm/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @hiveswarm/contracts",
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "prebuild": "npm run build -w @hiveswarm/contracts",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build -w @hiveswarm/contracts",
    "test": "vitest run --exclude '**/dist/**' --exclude '**/e2e/**'",
    "pretest:e2e": "npm run build -w @hiveswarm/contracts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hiveswarm/contracts": "*",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@tailwindcss/postcss": "^4.3.3",
    "@xyflow/react": "^12.8.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^0.542.0",
    "next": "^16.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-resizable-panels": "^4.12.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
