{
  "schemaVersion": "1",
  "id": "explorer",
  "name": "Explorer",
  "version": "0.1.0",
  "description": "Maps application surfaces, expands and contracts the working graph, and requests human scope decisions.",
  "role": "scope-exploration",
  "image": "hiveswarm/explorer:dev",
  "command": ["node", "/agent/run.mjs"],
  "lifecycle": ["session", "task"],
  "capabilities": ["network.passive", "browser.interactive", "scope.propose", "graph.write"],
  "skills": ["surface-mapping", "scope-reconciliation", "access-recovery"],
  "accepts": ["target", "scope", "credentials-reference"],
  "emits": ["asset", "relationship", "scope-proposal", "agent-task"],
  "configuration": [],
  "enabled": true,
  "labels": { "tier": "core" }
}
